{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rely.io Public Automations Self-Service Actions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Self-Service Actions",
        "type": "folder"
      },
      "items": [
